                st.write(f"**View:** {request['VIEW_NAME']}")
                st.write(f"**Type:** {request['REQUEST_TYPE']}")
                st.write(f"**Status:** {request['STATUS']}")
            with col2:
                st.write(f"**Submitted:** {request['CREATED_DATE']}")
                st.write(f"**Request ID:** {request['REQUEST_ID']}")
            
            st.write(f"**Description:** {request['DESCRIPTION']}")
            if request['COMMENTS']:
                st.write(f"**Reviewer Comments:** {request['COMMENTS']}")

def approver_dashboard():
    """Dashboard for approvers"""
    st.header("👥 Approver Dashboard")
    
    pending_requests = get_pending_requests()
    
    if pending_requests.empty:
        st.success("No pending requests to review!")
        return
    
    st.subheader(f"Pending Requests ({len(pending_requests)})")
    
    for _, request in pending_requests.iterrows():
        with st.expander(f"🟡 {request['VIEW_NAME']} - {request['REQUEST_TYPE']} by {request['REQUESTER']}"):
            col1, col2 = st.columns(2)
            with col1:
                st.write(f"**View:** {request['VIEW_NAME']}")
                st.write(f"**Type:** {request['REQUEST_TYPE']}")
                st.write(f"**Requester:** {request['REQUESTER']}")
            with col2:
                st.write(f"**Submitted:** {request['CREATED_DATE']}")
                st.write(f"**Request ID:** {request['REQUEST_ID']}")
            
            st.write(f"**Description:** {request['DESCRIPTION']}")
            
            # Approval actions
            col1, col2, col3 = st.columns([2, 1, 1])
            with col1:
                comments = st.text_input(f"Comments for Request {request['REQUEST_ID']}", 
                                       key=f"comments_{request['REQUEST_ID']}")
            with col2:
                if st.button("✅ Approve", key=f"approve_{request['REQUEST_ID']}"):
                    if approve_reject_request(request['REQUEST_ID'], 'APPROVED', comments):
                        st.success("Request approved!")
                        st.rerun()
                    else:
                        st.error("Failed to approve request")
            with col3:
                if st.button("❌ Reject", key=f"reject_{request['REQUEST_ID']}"):
                    if approve_reject_request(request['REQUEST_ID'], 'REJECTED', comments):
                        st.success("Request rejected!")
                        st.rerun()
                    else:
                        st.error("Failed to reject request")

def main():
    """Main application"""
    st.set_page_config(
        page_title="Denodo View Review System",
        page_icon="🗂️",
        layout="wide"
    )
    
    # Check if user is logged in
    if not st.session_state.logged_in:
        login_page()
        return
    
    # Sidebar navigation
    st.sidebar.title(f"Welcome, {st.session_state.username}!")
    st.sidebar.write(f"Role: {st.session_state.user_role}")
    
    menu_options = ["🏠 Dashboard", "📝 Raise New Request", "📊 View Change Log", "📋 My Requests"]
    
    # Add approver options if user is an approver
    if is_approver():
        menu_options.append("👥 Approver Dashboard")
    
    menu_options.append("🚪 Logout")
    
    choice = st.sidebar.selectbox("Navigation", menu_options)
    
    # Main content area
    if choice == "🏠 Dashboard":
        st.title("🗂️ Denodo View Review System")
        st.write("Welcome to the Denodo View Review System. Use the sidebar to navigate.")
        
        # Display some statistics
        col1, col2, col3 = st.columns(3)
        
        with col1:
            user_requests = get_user_requests()
            st.metric("My Total Requests", len(user_requests))
        
        with col2:
            pending_count = len(user_requests[user_requests['STATUS'] == 'PENDING']) if not user_requests.empty else 0
            st.metric("My Pending Requests", pending_count)
        
        with col3:
            if is_approver():
                pending_approvals = get_pending_requests()
                st.metric("Pending Approvals", len(pending_approvals))
    
    elif choice == "📝 Raise New Request":
        raise_new_request()
    
    elif choice == "📊 View Change Log":
        view_changelog()
    
    elif choice == "📋 My Requests":
        view_my_requests()
    
    elif choice == "👥 Approver Dashboard":
        if is_approver():
            approver_dashboard()
        else:
            st.error("Access denied. You don't have approver privileges.")
    
    elif choice == "🚪 Logout":
        st.session_state.logged_in = False
        st.session_state.username = None
        st.session_state.user_role = None
        st.session_state.user_id = None
        st.success("Logged out successfully!")
        st.rerun()

if __name__ == "__main__":
    main()
