class DatabaseManager:
    def __init__(self):
        self.connection = None
    
    def connect(self):
        """Establish database connection"""
        try:
            self.connection = cx_Oracle.connect(**DB_CONFIG)
            return True
        except Exception as e:
            st.error(f"Database connection error: {str(e)}")
            return False
    
    def disconnect(self):
        """Close database connection"""
        if self.connection:
            self.connection.close()
    
    def execute_query(self, query: str, params: tuple = None, fetch: bool = True):
        """Execute SQL query"""
        try:
            cursor = self.connection.cursor()
            if params:
                cursor.execute(query, params)
            else:
                cursor.execute(query)
            
            if fetch:
                result = cursor.fetchall()
                columns = [desc[0] for desc in cursor.description]
                cursor.close()
                return pd.DataFrame(result, columns=columns) if result else pd.DataFrame()
            else:
                self.connection.commit()
                cursor.close()
                return True
        except Exception as e:
            st.error(f"Query execution error: {str(e)}")
            return pd.DataFrame() if fetch else False
    
    def create_tables(self):
        """Create necessary database tables"""
        tables = [
            """
            CREATE TABLE IF NOT EXISTS users (
                user_id NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
                username VARCHAR2(50) UNIQUE NOT NULL,
                password_hash VARCHAR2(128) NOT NULL,
                email VARCHAR2(100),
                role VARCHAR2(20) DEFAULT 'USER',
                created_date DATE DEFAULT SYSDATE
            )
            """,
            """
            CREATE TABLE IF NOT EXISTS denodo_views (
                view_id NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
                view_name VARCHAR2(200) NOT NULL,
                folder_path VARCHAR2(500),
                description CLOB,
                created_date DATE DEFAULT SYSDATE,
                is_active NUMBER(1) DEFAULT 1
            )
            """,
            """
            CREATE TABLE IF NOT EXISTS view_requests (
                request_id NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
                view_id NUMBER REFERENCES denodo_views(view_id),
                requester_id NUMBER REFERENCES users(user_id),
                request_type VARCHAR2(20) CHECK (request_type IN ('NEW', 'UPDATE', 'DELETE')),
                description CLOB,
                status VARCHAR2(20) DEFAULT 'PENDING' CHECK (status IN ('PENDING', 'APPROVED', 'REJECTED')),
                created_date DATE DEFAULT SYSDATE,
                approved_by NUMBER REFERENCES users(user_id),
                approved_date DATE,
                comments CLOB
            )
            """,
            """
            CREATE TABLE IF NOT EXISTS approvers (
                approver_id NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
                user_id NUMBER REFERENCES users(user_id),
                is_active NUMBER(1) DEFAULT 1
            )
            """
        ]
        
        for table_sql in tables:
            try:
                self.execute_query(table_sql, fetch=False)
            except:
                pass  # Table might already exist

def hash_password(password: str) -> str:
    """Hash password for security"""
    return hashlib.sha256(password.encode()).hexdigest()

def authenticate_user(username: str, password: str) -> bool:
    """Authenticate user credentials"""
    db = DatabaseManager()
    if db.connect():
        try:
            query = "SELECT user_id, role FROM users WHERE username = :1 AND password_hash = :2"
            result = db.execute_query(query, (username, hash_password(password)))
            db.disconnect()
            
            if isinstance(result, pd.DataFrame) and not result.empty:
                st.session_state.logged_in = True
                st.session_state.username = username
                st.session_state.user_role = result.iloc[0]['ROLE']
                st.session_state.user_id = result.iloc[0]['USER_ID']
                return True
        except Exception as e:
            st.error(f"Authentication error: {str(e)}")
            db.disconnect()
    return False

def get_denodo_views() -> pd.DataFrame:
    """Fetch all Denodo views from database"""
    db = DatabaseManager()
    if db.connect():
        try:
            query = "SELECT view_id, view_name, folder_path, description FROM denodo_views WHERE is_active = 1 ORDER BY view_name"
            result = db.execute_query(query)
            db.disconnect()
            return result if isinstance(result, pd.DataFrame) else pd.DataFrame()
        except Exception as e:
            st.error(f"Error fetching views: {str(e)}")
            db.disconnect()
    return pd.DataFrame()

def submit_request(view_id: int, request_type: str, description: str) -> bool:
    """Submit a new view request"""
    db = DatabaseManager()
    if db.connect():
        try:
            query = """
            INSERT INTO view_requests (view_id, requester_id, request_type, description)
            VALUES (:1, :2, :3, :4)
            """
            success = db.execute_query(query, (view_id, st.session_state.user_id, request_type, description), fetch=False)
            db.disconnect()
            return success == True
        except Exception as e:
            st.error(f"Error submitting request: {str(e)}")
            db.disconnect()
    return False

def get_user_requests() -> pd.DataFrame:
    """Get all requests made by current user"""
    db = DatabaseManager()
    if db.connect():
        try:
            query = """
            SELECT vr.request_id, dv.view_name, vr.request_type, vr.description, 
                   vr.status, vr.created_date, vr.comments
            FROM view_requests vr
            JOIN denodo_views dv ON vr.view_id = dv.view_id
            WHERE vr.requester_id = :1
            ORDER BY vr.created_date DESC
            """
            result = db.execute_query(query, (st.session_state.user_id,))
            db.disconnect()
            return result if isinstance(result, pd.DataFrame) else pd.DataFrame()
        except Exception as e:
            st.error(f"Error fetching user requests: {str(e)}")
            db.disconnect()
    return pd.DataFrame()

def get_view_changelog() -> pd.DataFrame:
    """Get change log for all views"""
    db = DatabaseManager()
    if db.connect():
        try:
            query = """
            SELECT dv.view_name, vr.request_type, vr.status, 
                   u.username as requester, vr.created_date,
                   CASE WHEN vr.approved_by IS NOT NULL THEN u2.username ELSE NULL END as approved_by,
                   vr.approved_date
            FROM view_requests vr
            JOIN denodo_views dv ON vr.view_id = dv.view_id
            JOIN users u ON vr.requester_id = u.user_id
            LEFT JOIN users u2 ON vr.approved_by = u2.user_id
            ORDER BY dv.view_name, vr.created_date DESC
            """
            result = db.execute_query(query)
            db.disconnect()
            return result if isinstance(result, pd.DataFrame) else pd.DataFrame()
        except Exception as e:
            st.error(f"Error fetching changelog: {str(e)}")
            db.disconnect()
    return pd.DataFrame()

def get_requests_for_view(view_name: str) -> pd.DataFrame:
    """Get all requests for a specific view"""
    db = DatabaseManager()
    if db.connect():
        try:
            query = """
            SELECT vr.request_id, vr.request_type, vr.description, vr.status,
                   u.username as requester, vr.created_date,
                   CASE WHEN vr.approved_by IS NOT NULL THEN u2.username ELSE NULL END as approved_by,
                   vr.approved_date, vr.comments
            FROM view_requests vr
            JOIN denodo_views dv ON vr.view_id = dv.view_id
            JOIN users u ON vr.requester_id = u.user_id
            LEFT JOIN users u2 ON vr.approved_by = u2.user_id
            WHERE dv.view_name = :1
            ORDER BY vr.created_date DESC
            """
            result = db.execute_query(query, (view_name,))
            db.disconnect()
            return result if isinstance(result, pd.DataFrame) else pd.DataFrame()
        except Exception as e:
            st.error(f"Error fetching requests for view: {str(e)}")
            db.disconnect()
    return pd.DataFrame()

def get_pending_requests() -> pd.DataFrame:
    """Get all pending requests for approvers"""
    db = DatabaseManager()
    if db.connect():
        try:
            query = """
            SELECT vr.request_id, dv.view_name, vr.request_type, vr.description,
                   u.username as requester, vr.created_date
            FROM view_requests vr
            JOIN denodo_views dv ON vr.view_id = dv.view_id
            JOIN users u ON vr.requester_id = u.user_id
            WHERE vr.status = 'PENDING'
            ORDER BY vr.created_date ASC
            """
            result = db.execute_query(query)
            db.disconnect()
            return result if isinstance(result, pd.DataFrame) else pd.DataFrame()
        except Exception as e:
            st.error(f"Error fetching pending requests: {str(e)}")
            db.disconnect()
    return pd.DataFrame()

def approve_reject_request(request_id: int, action: str, comments: str = "") -> bool:
    """Approve or reject a request"""
    db = DatabaseManager()
    if db.connect():
        try:
            query = """
            UPDATE view_requests 
            SET status = :1, approved_by = :2, approved_date = SYSDATE, comments = :3
            WHERE request_id = :4
            """
            success = db.execute_query(query, (action, st.session_state.user_id, comments, request_id), fetch=False)
            db.disconnect()
            return success == True
        except Exception as e:
            st.error(f"Error updating request: {str(e)}")
            db.disconnect()
    return False

def is_approver() -> bool:
    """Check if current user is an approver"""
    if 'user_id' not in st.session_state:
        return False
        
    db = DatabaseManager()
    if db.connect():
        try:
            query = "SELECT 1 FROM approvers WHERE user_id = :1 AND is_active = 1"
            result = db.execute_query(query, (st.session_state.user_id,))
            db.disconnect()
            return isinstance(result, pd.DataFrame) and not result.empty
        except Exception as e:
            st.error(f"Error checking approver status: {str(e)}")
            db.disconnect()
    return False

