    request_id NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    view_id NUMBER NOT NULL,
    requester_id NUMBER NOT NULL,
    request_type VARCHAR2(20) NOT NULL CHECK (request_type IN ('NEW', 'UPDATE', 'DELETE')),
    description CLOB,
    status VARCHAR2(20) DEFAULT 'PENDING' CHECK (status IN ('PENDING', 'APPROVED', 'REJECTED')),
