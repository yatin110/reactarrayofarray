def raise_new_request():
    """Interface for raising new requests"""
    st.header("📝 Raise New Request")
    
    # Get all Denodo views
    views_df = get_denodo_views()
    
    if views_df.empty:
        st.warning("No Denodo views found. Please contact administrator.")
        return
    
    with st.form("new_request_form"):
        # View selection
        view_options = {f"{row['VIEW_NAME']} ({row['FOLDER_PATH']})": row['VIEW_ID'] 
                       for _, row in views_df.iterrows()}
        selected_view = st.selectbox("Select Denodo View", options=list(view_options.keys()))
        
        # Request type
        request_type = st.selectbox("Request Type", ["NEW", "UPDATE", "DELETE"])
        
        # Description
        description = st.text_area("Description", 
                                 placeholder="Please provide detailed description of the changes required...")
        
        # Submit button
        submit_button = st.form_submit_button("Submit Request")
        
        if submit_button:
            if selected_view and description:
                view_id = view_options[selected_view]
                if submit_request(view_id, request_type, description):
                    st.success("Request submitted successfully!")
                    st.balloons()
                else:
                    st.error("Failed to submit request. Please try again.")
            else:
                st.error("Please fill in all required fields.")

def view_changelog():
    """Display view change log"""
    st.header("📊 View Change Log")
    
    changelog_df = get_view_changelog()
    
    if changelog_df.empty:
        st.info("No change log entries found.")
        return
    
    # Group by view name
    unique_views = changelog_df['VIEW_NAME'].unique()
    selected_view = st.selectbox("Select View to see detailed log", 
                                ["All Views"] + list(unique_views))
    
    if selected_view == "All Views":
        # Show summary
        st.subheader("Summary of All Views")
        st.dataframe(changelog_df, use_container_width=True)
    else:
        # Show detailed log for selected view
        st.subheader(f"Detailed Log for: {selected_view}")
        view_requests = get_requests_for_view(selected_view)
        
        if not view_requests.empty:
            for _, request in view_requests.iterrows():
                with st.expander(f"{request['REQUEST_TYPE']} - {request['STATUS']} ({request['CREATED_DATE']})"):
                    col1, col2 = st.columns(2)
                    with col1:
                        st.write(f"**Requester:** {request['REQUESTER']}")
                        st.write(f"**Type:** {request['REQUEST_TYPE']}")
                        st.write(f"**Status:** {request['STATUS']}")
                    with col2:
                        st.write(f"**Submitted:** {request['CREATED_DATE']}")
                        if request['APPROVED_BY']:
                            st.write(f"**Approved by:** {request['APPROVED_BY']}")
                            st.write(f"**Approved on:** {request['APPROVED_DATE']}")
                    
                    st.write(f"**Description:** {request['DESCRIPTION']}")
                    if request['COMMENTS']:
                        st.write(f"**Comments:** {request['COMMENTS']}")
        else:
            st.info(f"No requests found for {selected_view}")

def view_my_requests():
    """Display user's own requests"""
    st.header("📋 My Requests")
    
    user_requests = get_user_requests()
    
    if user_requests.empty:
        st.info("You haven't submitted any requests yet.")
        return
    
    # Display requests in cards
    for _, request in user_requests.iterrows():
        status_color = {
            'PENDING': '🟡',
            'APPROVED': '🟢', 
            'REJECTED': '🔴'
        }.get(request['STATUS'], '⚪')
        
