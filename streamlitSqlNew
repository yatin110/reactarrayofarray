def create_template(engine):
    st.header("Create SQL Template")
    
    # Choose template type
    template_type = st.radio("Select Template Type", ["Parent Template", "Child Template"])
    
    if template_type == "Parent Template":
        create_parent_template(engine)
    else:
        create_child_template(engine)

def create_parent_template(engine):
    st.subheader("Create Parent Template")
    
    # Get all tables
    all_tables = get_tables(engine)
    
    # Template name
    template_name = st.text_input("Template Name", key="parent_template_name")
    
    # Table selection
    if all_tables:
        selected_table = st.selectbox("Select Base Table", all_tables, key="parent_base_table")
        
        if selected_table:
            # Get columns for the selected table
            base_columns_df = get_columns(engine, selected_table)
            
            # Join configuration
            st.subheader("Table Joins")
            
            joins = []
            for i in range(3):  # Allow up to 3 joins
                with st.expander(f"Join {i+1}", expanded=i==0):
                    col1, col2, col3, col4 = st.columns(4)
                    
                    with col1:
                        table1 = st.selectbox("Table 1", [selected_table] + [j.get('table2', '') for j in joins if j.get('table2')], 
                                             key=f"join_{i}_table1")
                    
                    with col2:
                        join_table = st.selectbox("Join Table", [t for t in all_tables if t != selected_table], 
                                                key=f"join_{i}_table2")
                    
                    if table1 and join_table:
                        with col3:
                            table1_cols = get_columns(engine, table1)['COLUMN_NAME'].tolist()
                            col1 = st.selectbox("Column from Table 1", table1_cols, key=f"join_{i}_col1")
                        
                        with col4:
                            table2_cols = get_columns(engine, join_table)['COLUMN_NAME'].tolist()
                            col2 = st.selectbox("Column from Join Table", table2_cols, key=f"join_{i}_col2")
                        
                        joins.append({
                            'table1': table1,
                            'table2': join_table,
                            'column1': col1,
                            'column2': col2
                        })
            
            # Column selection and aggregation
            st.subheader("Column Selection")
            
            # Get all available columns from all tables
            all_columns = []
            all_columns.extend([f"{selected_table}.{col}" for col in base_columns_df['COLUMN_NAME'].tolist()])
            
            for join in joins:
                if join.get('table2'):
                    join_cols = get_columns(engine, join.get('table2'))
                    all_columns.extend([f"{join.get('table2')}.{col}" for col in join_cols['COLUMN_NAME'].tolist()])
            
            # Column selection with aggregation
            selected_columns = []
            aggregations = []
            group_by_cols = []
            
            st.write("Select columns and aggregations:")
            
            for i in range(min(10, len(all_columns))):  # Limit to 10 columns for simplicity
                col1, col2, col3 = st.columns([3, 2, 1])
                
                with col1:
                    column = st.selectbox(f"Column {i+1}", [''] + all_columns, key=f"column_{i}")
                
                with col2:
                    agg = st.selectbox(f"Aggregation", ['None', 'SUM', 'AVG', 'COUNT', 'MIN', 'MAX'], key=f"agg_{i}")
                
                with col3:
                    group_by = st.checkbox("Group By", key=f"group_by_{i}", disabled=(agg != 'None'))
                
                if column:
                    selected_columns.append(column)
                    aggregations.append(agg)
                    if group_by and agg == 'None':
                        group_by_cols.append(column)
            
            # Generate SQL query
            if selected_columns:
                sql_query = generate_sql_query(
                    [selected_table], 
                    joins, 
                    selected_columns, 
                    aggregations, 
                    group_by_cols
                )
                
                st.subheader("Generated SQL Query")
                st.code(sql_query, language="sql")
                
                # Save template
                if st.button("Save Template"):
                    if not template_name:
                        st.error("Please provide a template name")
                    else:
                        # Prepare template data
                        template_data = {
                            'template_name': template_name,
                            'sql_query': sql_query,
                            'is_parent': True,
                            'template_data': str({
                                'base_table': selected_table,
                                'joins': joins,
                                'columns': selected_columns,
                                'aggregations': aggregations,
                                'group_by': group_by_cols
                            })
                        }
                        
                        if save_template(engine, template_data):
                            st.success("Template saved successfully!")
                        else:
                            st.error("Failed to save template")
    else:
        st.warning("No tables found in the database or connection issue.")

def create_child_template(engine):
    st.subheader("Create Child Template")
    
    # Get parent templates
    parent_templates = get_templates(engine, parent_only=True)
    
    if not parent_templates.empty:
        # Template name
        template_name = st.text_input("Child Template Name", key="child_template_name")
        
        # Parent template selection
        selected_parent = st.selectbox(
            "Select Parent Template", 
            parent_templates['TEMPLATE_NAME'].tolist(),
            key="parent_template_selection"
        )
        
        if selected_parent:
            # Get parent template details
            parent_id = parent_templates[parent_templates['TEMPLATE_NAME'] == selected_parent]['TEMPLATE_ID'].iloc[0]
            parent_details = get_template_details(engine, parent_id)
            
            if parent_details is not None:
                parent_sql = parent_details['SQL_QUERY']
                
                # Parse parent SQL to get available columns
                available_columns = parse_parent_sql(parent_sql)
                
                # Column selection
                st.subheader("Select Columns")
                selected_columns = st.multiselect("Columns", available_columns)
                
                # Filter conditions
                st.subheader("Filter Conditions")
                
                where_conditions = []
                for i in range(3):  # Allow up to 3 conditions
                    with st.expander(f"Condition {i+1}", expanded=i==0):
                        col1, col2, col3 = st.columns(3)
                        
                        with col1:
                            column = st.selectbox("Column", [''] + available_columns, key=f"where_col_{i}")
                        
                        with col2:
                            operator = st.selectbox("Operator", ['=', '<>', '>', '<', '>=', '<=', 'LIKE', 'IN'], key=f"where_op_{i}")
                        
                        with col3:
                            value = st.text_input("Value", key=f"where_val_{i}")
                        
                        if column and operator:
                            where_conditions.append({
                                'column': column,
                                'operator': operator,
                                'value': value
                            })
                
                # Generate child SQL
                if selected_columns:
                    # Extract the main parts of the parent query
                    parent_from_part = parent_sql.split("FROM", 1)[1]
                    if "WHERE" in parent_from_part:
                        parent_from_part = parent_from_part.split("WHERE", 1)[0]
                    if "GROUP BY" in parent_from_part:
                        parent_from_part = parent_from_part.split("GROUP BY", 1)[0]
                    
                    # Create the child query
                    child_sql = f"SELECT {', '.join(selected_columns)}\nFROM{parent_from_part}"
                    
                    # Add WHERE clause if needed
                    if where_conditions:
                        conditions = []
                        for condition in where_conditions:
                            if condition['column'] and condition['operator'] and condition['value']:
                                value = condition['value']
                                if condition['operator'] in ['=', '<>', '>', '<', '>=', '<=']:
                                    if not value.isdigit():
                                        value = f"'{value}'"
                                    conditions.append(f"{condition['column']} {condition['operator']} {value}")
                                elif condition['operator'] == 'LIKE':
                                    conditions.append(f"{condition['column']} LIKE '%{value}%'")
                                elif condition['operator'] == 'IN':
                                    values = [f"'{v.strip()}'" for v in value.split(',')]
                                    conditions.append(f"{condition['column']} IN ({', '.join(values)})")
                        
                        if conditions:
                            child_sql += "\nWHERE " + " AND ".join(conditions)
                    
                    st.subheader("Generated SQL Query")
                    st.code(child_sql, language="sql")
                    
                    # Save template
                    if st.button("Save Child Template"):
                        if not template_name:
                            st.error("Please provide a template name")
                        else:
                            # Prepare template data
                            template_data = {
                                'template_name': template_name,
                                'sql_query': child_sql,
                                'is_parent': False,
                                'parent_id': parent_id,
                                'template_data': str({
                                    'parent_id': parent_id,
                                    'parent_name': selected_parent,
                                    'columns': selected_columns,
                                    'where_conditions': where_conditions
                                })
                            }
                            
                            if save_template(engine, template_data):
                                st.success("Child template saved successfully!")
                            else:
                                st.error("Failed to save template")
    else:
        st.warning("No parent templates found. Please create a parent template first.")

def edit_template(engine):
    st.header("Edit SQL Template")
    
    # Get all templates
    templates = get_templates(engine)
    
    if not templates.empty:
        selected_template = st.selectbox(
            "Select Template to Edit", 
            templates['TEMPLATE_NAME'].tolist(),
            key="edit_template_selection"
        )
        
        if selected_template:
            # Get template details
            template_id = templates[templates['TEMPLATE_NAME'] == selected_template]['TEMPLATE_ID'].iloc[0]
            is_parent = templates[templates['TEMPLATE_NAME'] == selected_template]['IS_PARENT'].iloc[0]
            
            template_details = get_template_details(engine, template_id)
            
            if template_details is not None:
                # Show current SQL
                st.subheader("Current SQL Query")
                st.code(template_details['SQL_QUERY'], language="sql")
                
                # Edit mode based on template type
                if is_parent:
                    edit_parent_template(engine, template_details)
                else:
                    edit_child_template(engine, template_details)
    else:
        st.warning("No templates found. Please create a template first.")

def edit_parent_template(engine, template_details):
    st.subheader("Edit Parent Template")
    
    # Template name
    template_name = st.text_input("Template Name", value=template_details['TEMPLATE_NAME'], key="edit_parent_name")
    
    # Get template data
    template_data = eval(template_details['TEMPLATE_DATA'])
    
    # Get all tables
    all_tables = get_tables(engine)
    
    # Base table (read-only in edit mode)
    st.write(f"Base Table: {template_data['base_table']}")
    selected_table = template_data['base_table']
    
    # Edit joins
    st.subheader("Edit Table Joins")
    
    joins = template_data['joins'].copy()
    for i, join in enumerate(joins):
        with st.expander(f"Join {i+1}", expanded=True):
            col1, col2, col3, col4 = st.columns(4)
            
            with col1:
                st.write(f"Table 1: {join['table1']}")
            
            with col2:
                new_join_table = st.selectbox("Join Table", all_tables, 
                                          index=all_tables.index(join['table2']) if join['table2'] in all_tables else 0,
                                          key=f"edit_join_{i}_table2")
            
            if new_join_table:
                with col3:
                    table1_cols = get_columns(engine, join['table1'])['COLUMN_NAME'].tolist()
                    new_col1 = st.selectbox("Column from Table 1", table1_cols, 
                                         index=table1_cols.index(join['column1']) if join['column1'] in table1_cols else 0,
                                         key=f"edit_join_{i}_col1")
                
                with col4:
                    table2_cols = get_columns(engine, new_join_table)['COLUMN_NAME'].tolist()
                    new_col2 = st.selectbox("Column from Join Table", table2_cols, 
                                         index=table2_cols.index(join['column2']) if join['column2'] in table2_cols and new_join_table == join['table2'] else 0,
                                         key=f"edit_join_{i}_col2")
                
                joins[i] = {
                    'table1': join['table1'],
                    'table2': new_join_table,
                    'column1': new_col1,
                    'column2': new_col2
                }
    
    # Get all available columns
    all_columns = []
    all_columns.extend([f"{selected_table}.{col}" for col in get_columns(engine, selected_table)['COLUMN_NAME'].tolist()])
    
    for join in joins:
        if join.get('table2'):
            join_cols = get_columns(engine, join.get('table2'))
            all_columns.extend([f"{join.get('table2')}.{col}" for col in join_cols['COLUMN_NAME'].tolist()])
    
    # Edit column selection and aggregation
    st.subheader("Edit Column Selection")
    
    selected_columns = template_data['columns'].copy()
    aggregations = template_data['aggregations'].copy()
    group_by_cols = template_data['group_by'].copy()
    
    # Make sure we have enough placeholders
    while len(selected_columns) < 10:
        selected_columns.append('')
        aggregations.append('None')
    
    new_selected_columns = []
    new_aggregations = []
    new_group_by_cols = []
    
    for i in range(10):  # Limit to 10 columns for simplicity
        col1, col2, col3 = st.columns([3, 2, 1])
        
        with col1:
            column = st.selectbox(f"Column {i+1}", [''] + all_columns, 
                              index=(all_columns.index(selected_columns[i]) + 1) if i < len(selected_columns) and selected_columns[i] in all_columns else 0,
                              key=f"edit_column_{i}")
        
        with col2:
            agg_options = ['None', 'SUM', 'AVG', 'COUNT', 'MIN', 'MAX']
            agg = st.selectbox(f"Aggregation", agg_options, 
                            index=agg_options.index(aggregations[i]) if i < len(aggregations) else 0,
                            key=f"edit_agg_{i}")
        
        with col3:
            is_in_group_by = selected_columns[i] in group_by_cols if i < len(selected_columns) else False
            group_by = st.checkbox("Group By", value=is_in_group_by, 
                                key=f"edit_group_by_{i}", disabled=(agg != 'None'))
        
        if column:
            new_selected_columns.append(column)
            new_aggregations.append(agg)
            if group_by and agg == 'None':
                new_group_by_cols.append(column)
    
    # Generate SQL query
    if new_selected_columns:
        sql_query = generate_sql_query(
            [selected_table], 
            joins, 
            new_selected_columns, 
            new_aggregations, 
            new_group_by_cols
        )
        
        st.subheader("Updated SQL Query")
        st.code(sql_query, language="sql")
        
        # Save updated template
        if st.button("Save Updated Template"):
            if not template_name:
                st.error("Please provide a template name")
            else:
                # Prepare template data
                updated_template_data = {
                    'template_id': template_details['TEMPLATE_ID'],
                    'template_name': template_name,
                    'sql_query': sql_query,
                    'is_parent': True,
                    'template_data': str({
                        'base_table': selected_table,
                        'joins': joins,
                        'columns': new_selected_columns,
                        'aggregations': new_aggregations,
                        'group_by': new_group_by_cols
                    })
                }
                
                if save_template(engine, updated_template_data):
                    st.success("Template updated successfully!")
                else:
                    st.error("Failed to update template")

def edit_child_template(engine, template_details):
    st.subheader("Edit Child Template")
    
    # Template name
    template_name = st.text_input("Template Name", value=template_details['TEMPLATE_NAME'], key="edit_child_name")
    
    # Get template data
    template_data = eval(template_details['TEMPLATE_DATA'])
    
    # Get parent template details
    parent_id = template_details['PARENT_ID']
    parent_details = get_template_details(engine, parent_id)
    
    if parent_details is not None:
        st.write(f"Parent Template: {parent_details['TEMPLATE_NAME']}")
        
        parent_sql = parent_details['SQL_QUERY']
        
        # Parse parent SQL to get available columns
        available_columns = parse_parent_sql(parent_sql)
        
        # Column selection
        st.subheader("Select Columns")
        selected_columns = st.multiselect("Columns", available_columns, 
                                      default=template_data['columns'],
                                      key="edit_child_columns")
        
        # Filter conditions
        st.subheader("Filter Conditions")
        
        where_conditions = template_data.get('where_conditions', []).copy()
        # Ensure we have at least 3 condition slots
        while len(where_conditions) < 3:
            where_conditions.append({'column': '', 'operator': '=', 'value': ''})
        
        new_where_conditions = []
        for i in range(3):  # Allow up to 3 conditions
            with st.expander(f"Condition {i+1}", expanded=i < len(template_data.get('where_conditions', []))):
                col1, col2, col3 = st.columns(3)
                
                with col1:
                    column = st.selectbox("Column", [''] + available_columns, 
                                       index=(available_columns.index(where_conditions[i]['column']) + 1) if i < len(where_conditions) and where_conditions[i]['column'] in available_columns else 0,
                                       key=f"edit_where_col_{i}")
                
                with col2:
                    operators = ['=', '<>', '>', '<', '>=', '<=', 'LIKE', 'IN']
                    operator = st.selectbox("Operator", operators, 
                                         index=operators.index(where_conditions[i]['operator']) if i < len(where_conditions) else 0,
                                         key=f"edit_where_op_{i}")
                
                with col3:
                    value = st.text_input("Value", 
                                       value=where_conditions[i]['value'] if i < len(where_conditions) else '',
                                       key=f"edit_where_val_{i}")
                
                if column and operator:
                    new_where_conditions.append({
                        'column': column,
                        'operator': operator,
                        'value': value
                    })
        
        # Generate child SQL
        if selected_columns:
            # Extract the main parts of the parent query
            parent_from_part = parent_sql.split("FROM", 1)[1]
            if "WHERE" in parent_from_part:
                parent_from_part = parent_from_part.split("WHERE", 1)[0]
            if "GROUP BY" in parent_from_part:
                parent_from_part = parent_from_part.split("GROUP BY", 1)[0]
            
            # Create the child query
            child_sql = f"SELECT {', '.join(selected_columns)}\nFROM{parent_from_part}"
            
            # Add WHERE clause if needed
            if new_where_conditions:
                conditions = []
                for condition in new_where_conditions:
                    if condition['column'] and condition['operator'] and condition['value']:
                        value = condition['value']
                        if condition['operator'] in ['=', '<>', '>', '<', '>=', '<=']:
                            if not value.isdigit():
                                value = f"'{value}'"
                            conditions.append(f"{condition['column']} {condition['operator']} {value}")
                        elif condition['operator'] == 'LIKE':
                            conditions.append(f"{condition['column']} LIKE '%{value}%'")
                        elif condition['operator'] == 'IN':
                            values = [f"'{v.strip()}'" for v in value.split(',')]
                            conditions.append(f"{condition['column']} IN ({', '.join(values)})")
                
                if conditions:
                    child_sql += "\nWHERE " + " AND ".join(conditions)
            
            st.subheader("Updated SQL Query")
            st.code(child_sql, language="sql")
            
            # Save template
            if st.button("Save Updated Template"):
                if not template_name:
                    st.error("Please provide a template name")
                else:
                    # Prepare template data
                    updated_template_data = {
                        'template_id': template_details['TEMPLATE_ID'],
                        'template_name': template_name,
                        'sql_query': child_sql,
                        'is_parent': False,
                        'parent_id': parent_id,
                        'template_data': str({
                            'parent_id': parent_id,
                            'parent_name': parent_details['TEMPLATE_NAME'],
                            'columns': selected_columns,
                            'where_conditions': new_where_conditions
                        })
                    }
                    
                    if save_template(engine, updated_template_data):
                        st.success("Child template updated successfully!")
                    else:
                        st.error("Failed to update template")

def view_templates(engine):
    st.header("View SQL Templates")
    
    # Get all templates
    templates = get_templates(engine)
    
    if not templates.empty:
        # Display templates table
        st.dataframe(templates[['TEMPLATE_ID', 'TEMPLATE_NAME', 'IS_PARENT']])
        
        # View specific template
        selected_template = st.selectbox(
            "Select Template to View", 
            templates['TEMPLATE_NAME'].tolist(),
            key="view_template_selection"
        )
        
        if selected_template:
            # Get template details
            template_id = templates[templates['TEMPLATE_NAME'] == selected_template]['TEMPLATE_ID'].iloc[0]
            template_details = get_template_details(engine, template_id)
            
            if template_details is not None:
                # Show template info
                st.subheader(f"Template: {template_details['TEMPLATE_NAME']}")
                st.write(f"Type: {'Parent' if template_details['IS_PARENT'] == 1 else 'Child'}")
                
                if template_details['PARENT_ID'] is not None:
                    parent_details = get_template_details(engine, template_details['PARENT_ID'])
                    if parent_details is not None:
                        st.write(f"Parent Template: {parent_details['TEMPLATE_NAME']}")
                
                # Show SQL
                st.subheader("SQL Query")
                st.code(template_details['SQL_QUERY'], language="sql")
                
                # Execute query option
                if st.button("Execute Query"):
                    try:
                        # Execute query
                        engine = get_db_connection()
                        result = pd.read_sql(template_details['SQL_QUERY'], engine)
                        
                        # Show results
                        st.subheader("Query Results")
                        st.dataframe(result)
                        
                        # Allow download as CSV
                        csv = result.to_csv(index=False)
                        st.download_button(
                            label="Download CSV",
                            data=csv,
                            file_name=f"{template_details['TEMPLATE_NAME']}.csv",
                            mime="text/csv"
                        )
                    except Exception as e:
                        st.error(f"Error executing query: {e}")
    else:
        st.warning("No templates found. Please create a template first.")

