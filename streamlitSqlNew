import streamlit as st
import cx_Oracle
import pandas as pd
from sqlalchemy import create_engine

# Database connection setup
def get_db_connection():
    try:
        connection_string = st.session_state.get('connection_string', '')
        if not connection_string:
            return None
        engine = create_engine(f'oracle+cx_oracle://{connection_string}')
        return engine
    except Exception as e:
        st.error(f"Database connection error: {e}")
        return None

# Get tables from Oracle DB
def get_tables(engine):
    if engine is None:
        return []
    query = """
    SELECT table_name FROM user_tables
    UNION
    SELECT view_name FROM user_views
    ORDER BY 1
    """
    return pd.read_sql(query, engine)['TABLE_NAME'].tolist()

# Get columns for a specific table
def get_columns(engine, table_name):
    if engine is None or not table_name:
        return []
    query = f"""
    SELECT column_name, data_type
    FROM user_tab_columns
    WHERE table_name = '{table_name}'
    ORDER BY column_id
    """
    return pd.read_sql(query, engine)

# Get all templates
def get_templates(engine, parent_only=False):
    if engine is None:
        return []
    where_clause = "WHERE parent_id IS NULL" if parent_only else ""
    query = f"""
    SELECT template_id, template_name, is_parent
    FROM sql_templates
    {where_clause}
    ORDER BY template_name
    """
    try:
        return pd.read_sql(query, engine)
    except:
        st.warning("SQL templates table doesn't exist yet. It will be created when you save your first template.")
        return pd.DataFrame(columns=['TEMPLATE_ID', 'TEMPLATE_NAME', 'IS_PARENT'])

# Get template details
def get_template_details(engine, template_id):
    if engine is None:
        return None
    query = f"""
    SELECT * FROM sql_templates
    WHERE template_id = {template_id}
    """
    return pd.read_sql(query, engine).iloc[0]

# Save template to database
def save_template(engine, template_data):
    if engine is None:
        return False
    
    # Check if SQL_TEMPLATES table exists, create if not
    with engine.connect() as conn:
        table_exists = conn.execute("""
        SELECT COUNT(*) FROM user_tables WHERE table_name = 'SQL_TEMPLATES'
        """).scalar()
        
        if not table_exists:
            conn.execute("""
            CREATE TABLE sql_templates (
                template_id NUMBER PRIMARY KEY,
                template_name VARCHAR2(100) NOT NULL,
                sql_query CLOB NOT NULL,
                is_parent NUMBER(1) DEFAULT 1,
                parent_id NUMBER,
                template_data CLOB,
                created_date DATE DEFAULT SYSDATE,
                modified_date DATE DEFAULT SYSDATE,
                CONSTRAINT fk_parent FOREIGN KEY (parent_id) 
                REFERENCES sql_templates(template_id)
            )
            """)
            
            conn.execute("""
            CREATE SEQUENCE sql_template_seq START WITH 1 INCREMENT BY 1
            """)
    
    # Insert or update template
    with engine.connect() as conn:
        if 'template_id' in template_data and template_data['template_id']:
            # Update existing template
            template_id = template_data['template_id']
            conn.execute(f"""
            UPDATE sql_templates SET 
                template_name = '{template_data['template_name']}',
                sql_query = '{template_data['sql_query']}',
                is_parent = {1 if template_data['is_parent'] else 0},
                parent_id = {template_data.get('parent_id', 'NULL')},
                template_data = '{template_data['template_data']}',
                modified_date = SYSDATE
            WHERE template_id = {template_id}
            """)
        else:
            # Insert new template
            template_id = conn.execute("SELECT sql_template_seq.NEXTVAL FROM dual").scalar()
            parent_id = f"{template_data.get('parent_id', 'NULL')}"
            if parent_id == 'None' or parent_id == '':
                parent_id = 'NULL'
                
            conn.execute(f"""
            INSERT INTO sql_templates (
                template_id, template_name, sql_query, is_parent, parent_id, template_data
            ) VALUES (
                {template_id},
                '{template_data['template_name']}',
                '{template_data['sql_query']}',
                {1 if template_data['is_parent'] else 0},
                {parent_id},
                '{template_data['template_data']}'
            )
            """)
    
    return True

# Generate SQL query based on user selections
def generate_sql_query(tables, joins, columns, aggregations, group_by_cols, where_conditions=None):
    # Prepare SELECT clause
    select_clause = []
    for col, agg in zip(columns, aggregations):
        if agg == 'None':
            select_clause.append(col)
        else:
            col_name = col.split('.')[-1]
            select_clause.append(f"{agg}({col}) as {agg}_{col_name}")
    
    # Prepare FROM clause
    from_clause = tables[0]
    
    # Prepare JOIN clause
    join_clause = []
    for join in joins:
        if join['table1'] and join['table2'] and join['column1'] and join['column2']:
            join_clause.append(f"JOIN {join['table2']} ON {join['table1']}.{join['column1']} = {join['table2']}.{join['column2']}")
    
    # Prepare WHERE clause
    where_clause = ""
    if where_conditions and len(where_conditions) > 0:
        conditions = []
        for condition in where_conditions:
            if condition['column'] and condition['operator'] and condition['value']:
                value = condition['value']
                # Check if value should be quoted
                if condition['operator'] in ['=', '<>', '>', '<', '>=', '<=']:
                    if not value.isdigit():
                        value = f"'{value}'"
                    conditions.append(f"{condition['column']} {condition['operator']} {value}")
                elif condition['operator'] == 'LIKE':
                    conditions.append(f"{condition['column']} LIKE '%{value}%'")
                elif condition['operator'] == 'IN':
                    values = [f"'{v.strip()}'" for v in value.split(',')]
                    conditions.append(f"{condition['column']} IN ({', '.join(values)})")
        
        if conditions:
            where_clause = "WHERE " + " AND ".join(conditions)
    
    # Prepare GROUP BY clause
    group_by_clause = ""
    if group_by_cols and len(group_by_cols) > 0:
        group_by_clause = "GROUP BY " + ", ".join(group_by_cols)
    
    # Combine all clauses
    sql_parts = [
        "SELECT " + ", ".join(select_clause),
        "FROM " + from_clause
    ]
    
    if join_clause:
        sql_parts.extend(join_clause)
    
    if where_clause:
        sql_parts.append(where_clause)
    
    if group_by_clause:
        sql_parts.append(group_by_clause)
    
    return "\n".join(sql_parts)

# Function to parse a SQL query (simplified for this example)
def parse_parent_sql(sql_query):
    # This is a simplified parser - in a real app, you'd use a proper SQL parser
    select_clause = sql_query.split("FROM")[0].replace("SELECT", "").strip()
    columns = [col.strip() for col in select_clause.split(",")]
    return columns

